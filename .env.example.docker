APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

LOG_STACK=daily,stdout,activity,stderr
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
ACTIVITY_LOG_LEVEL=info
