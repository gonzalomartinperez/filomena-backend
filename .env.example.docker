MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=notifications@example.test
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
MEDIA_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PROMETHEUS_BEARER_TOKEN=
GRAFANA_USER=admin
GRAFANA_PASSWORD=

INITIAL_ADMIN_DNI=
INITIAL_ADMIN_RECORD_ID=
